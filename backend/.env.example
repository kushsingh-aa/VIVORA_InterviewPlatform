# Port configuration
PORT=5000

# MongoDB Database Connection (optional - falls back to in-memory store)
MONGODB_URI=

# AI Provider API Keys (Supports OpenRouter, OpenAI, Google Gemini)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openai/gpt-4o-mini

# Optional Direct OpenAI / Gemini Keys
OPENAI_API_KEY=
GEMINI_API_KEY=

# Security (REQUIRED - generate a strong random string, e.g. openssl rand -hex 32)
JWT_SECRET=change_this_to_a_strong_random_secret

# Optional: restrict CORS origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000
