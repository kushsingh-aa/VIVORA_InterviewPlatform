# Port configuration
PORT=5000

# AI Provider API Keys (Supports OpenRouter, OpenAI, Google Gemini, and Groq)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openai/gpt-4o-mini

# Optional Direct OpenAI / Gemini Keys
OPENAI_API_KEY=
GEMINI_API_KEY=

# Security
JWT_SECRET=your_jwt_secret_key_here

# PostgreSQL Database (Optional - App includes automatic in-memory fallback)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=vivora
