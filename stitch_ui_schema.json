{
  "$schema": "https://stitch.design/schema/v2/design-system.json",
  "project": {
    "name": "VIVORA AI",
    "version": "2.0.0",
    "description": "Autonomous Conversational Interview Assessment Platform",
    "theme": "Cyber-Glassmorphism",
    "framework": "React 18 + Vite + Tailwind CSS"
  },
  "designTokens": {
    "colors": {
      "brand": {
        "primary": "#6366f1",
        "primaryHover": "#4f46e5",
        "secondary": "#a855f7",
        "accent": "#06b6d4",
        "gradientPrimary": "linear-gradient(135deg, #6366f1 0%, #a855f7 100%)",
        "gradientDarkMesh": "linear-gradient(135deg, #020617 0%, #0f172a 50%, #1e1b4b 100%)"
      },
      "surface": {
        "darkBackground": "#020617",
        "darkCard": "rgba(15, 23, 42, 0.85)",
        "darkCardHover": "rgba(30, 41, 59, 0.9)",
        "darkBorder": "rgba(255, 255, 255, 0.08)",
        "lightBackground": "#f8fafc",
        "lightCard": "rgba(255, 255, 255, 0.9)",
        "lightBorder": "rgba(226, 232, 240, 0.8)"
      },
      "status": {
        "success": "#10b981",
        "warning": "#f59e0b",
        "error": "#ef4444",
        "info": "#3b82f6"
      }
    },
    "typography": {
      "fontPrimary": "Plus Jakarta Sans, sans-serif",
      "fontMono": "JetBrains Mono, monospace",
      "weights": {
        "regular": 400,
        "medium": 500,
        "semibold": 600,
        "bold": 700,
        "black": 900
      }
    },
    "effects": {
      "glassmorphism": {
        "backdropBlur": "blur(16px)",
        "boxShadow": "0 10px 30px -10px rgba(99, 102, 241, 0.2)"
      },
      "neonGlow": {
        "indigo": "0 0 25px rgba(99, 102, 241, 0.35)",
        "emerald": "0 0 25px rgba(16, 185, 129, 0.35)",
        "purple": "0 0 25px rgba(168, 85, 247, 0.35)"
      }
    },
    "animations": {
      "equalizerBounce": "barWave 0.9s ease-in-out infinite alternate",
      "radarSweep": "radarSweep 10s linear infinite",
      "pulseGlow": "pulseGlow 2.5s cubic-bezier(0.4, 0, 0.6, 1) infinite"
    }
  },
  "views": [
    {
      "viewId": "login_module",
      "name": "Authentication & Instant Demo",
      "layout": "centered-card",
      "components": [
        {
          "type": "BrandHeader",
          "properties": {
            "title": "VIVORA AI",
            "subtitle": "Autonomous Conversational Assessment Engine",
            "avatar": "🤖"
          }
        },
        {
          "type": "AuthForm",
          "fields": ["email", "password"],
          "actions": [
            { "id": "submit_login", "label": "Enter Assessment Portal", "variant": "primary" },
            { "id": "instant_demo", "label": "⚡ Launch Instant Demo Mode (No Login Required)", "variant": "secondary" }
          ]
        }
      ]
    },
    {
      "viewId": "dashboard",
      "name": "Assessment Dashboard",
      "layout": "sidebar-content",
      "components": [
        {
          "type": "HeroBanner",
          "properties": {
            "headline": "Master Your Next Interview with Adaptive AI Intelligence",
            "subheadline": "Experience dynamic scenario questions generated live from your answers with real-time biometric HUD and rubric telemetry.",
            "gradient": "from-slate-900 via-indigo-950 to-slate-900"
          }
        },
        {
          "type": "SenioritySelector",
          "properties": {
            "default": "Senior",
            "tiers": [
              { "id": "Junior", "label": "Junior (0-2 YOE)", "focus": "Fundamentals, clean CRUD APIs, input validation, SQL indexing." },
              { "id": "Mid-Level", "label": "Mid-Level (3-5 YOE)", "focus": "Microservices, Redis caching, worker queues, defensive error handling." },
              { "id": "Senior", "label": "Senior (5-8 YOE)", "focus": "Distributed scale, concurrency locking (Redlock), stampede isolation, tradeoffs." },
              { "id": "Staff/Lead", "label": "Staff / Lead (8+ YOE)", "focus": "Planetary active-active topologies, consensus, zero-downtime sharding." }
            ]
          }
        },
        {
          "type": "AssessmentTrackGrid",
          "tracks": [
            { "id": "software", "name": "Software Engineering Core", "icon": "Terminal", "badge": "Distributed Scale" },
            { "id": "system_design", "name": "System Design & Architecture", "icon": "Database", "badge": "Planetary Topologies" },
            { "id": "product", "name": "Product Management Lead", "icon": "TrendingUp", "badge": "Strategy & GTM" },
            { "id": "behavioral", "name": "Behavioral & Leadership", "icon": "Users", "badge": "Executive EQ & STAR" }
          ]
        }
      ]
    },
    {
      "viewId": "interview_chamber",
      "name": "Live Assessment Chamber",
      "layout": "two-column-split-8-4",
      "components": [
        {
          "type": "PersonaHeader",
          "properties": {
            "interviewerPersona": "Alex Rivera (Principal Architect & Bar Raiser)",
            "seniorityBadge": "Senior Level",
            "timer": { "durationMinutes": 20, "countdown": true },
            "actions": ["Replay Voice", "End Chamber 🛑"]
          }
        },
        {
          "type": "ChatDialogueStream",
          "properties": {
            "autoScroll": true,
            "formatting": "markdown",
            "features": ["Deep-Dive Follow-up Probe Badges", "Real-Time Rubric Score Chips", "AI Typing Indicator"]
          }
        },
        {
          "type": "CandidateInputDock",
          "properties": {
            "multiline": true,
            "voiceSTT": { "enabled": true, "liveWaveform": true },
            "templateButtons": ["STAR Template", "Tradeoff Matrix"],
            "hintAction": { "enabled": true, "label": "Need a Hint?" }
          }
        },
        {
          "type": "BiometricsTelemetryHUD",
          "properties": {
            "webcamStream": true,
            "radarReticle": { "animated": true, "fps": 60 },
            "gauges": [
              { "key": "wpm", "label": "Cadence WPM", "value": 128 },
              { "key": "clarity", "label": "Speech Clarity", "value": "92%" },
              { "key": "composure", "label": "Composure Index", "value": "88%" },
              { "key": "focus", "label": "Focal Attention", "value": "94%" }
            ]
          }
        },
        {
          "type": "CopilotCoachingDrawer",
          "properties": {
            "drawerPosition": "right",
            "assistantRole": "In-Session Interview Coach",
            "quickPrompts": ["STAR Framework", "Key Trade-offs", "Root Cause Analysis"]
          }
        }
      ]
    },
    {
      "viewId": "scorecard",
      "name": "Executive Evaluation Scorecard",
      "layout": "report-dashboard",
      "components": [
        {
          "type": "ExecutiveVerdictBadge",
          "properties": {
            "overallScore": 84,
            "recommendations": ["Strong Hire", "Hire", "Leaning Hire", "Needs Development"]
          }
        },
        {
          "type": "MetricRadarGrid",
          "metrics": [
            { "name": "Technical Depth", "score": 86 },
            { "name": "Problem Solving", "score": 85 },
            { "name": "Communication", "score": 82 },
            { "name": "Composure & Pace", "score": 88 }
          ]
        },
        {
          "type": "ValidatedStrengthsList",
          "icon": "CheckCircle2"
        },
        {
          "type": "TargetedGrowthList",
          "icon": "TrendingUp"
        },
        {
          "type": "DialogueBreakdownList",
          "properties": {
            "expandableCritiques": true
          }
        },
        {
          "type": "ExportReportAction",
          "properties": {
            "fileFormat": ".txt",
            "label": "Download Telemetry Report (.txt)"
          }
        }
      ]
    },
    {
      "viewId": "history_archive",
      "name": "Historical Evaluation Archive",
      "layout": "data-table-cards",
      "properties": {
        "dataSource": "MongoDB Atlas (Interview Collection)",
        "features": ["Track Filter", "Score Sorting", "One-Click Scorecard Modal View"]
      }
    },
    {
      "viewId": "assistance_matrix",
      "name": "Platform Diagnostics & Support",
      "layout": "two-column-form",
      "properties": {
        "dispatchTicket": true,
        "systemHealthMonitoring": ["OpenRouter LLM", "Web Speech Engine", "MongoDB Atlas"]
      }
    }
  ]
}
